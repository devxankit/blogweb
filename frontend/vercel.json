{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cosmoslens.vercel.app" }],
      "destination": "https://www.cosmoslens.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/stories/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
