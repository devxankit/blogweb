# ---- Server-only (never sent to the browser) ----

# Base URL of the Node API in backend/.
API_URL=http://localhost:4000

# Shared secret: must equal INTERNAL_API_KEY in backend/.env. Lets this server
# report page views and pass readers' IPs to the API's rate limits.
INTERNAL_API_KEY=

# Signs the admin session cookie. A long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---- Public (baked into the build) ----

# Public origin of the site, no trailing slash. Used for canonical URLs,
# Open Graph tags, JSON-LD, the sitemap and the RSS feed.
VITE_SITE_URL=https://cosmoslens.com

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty to keep
# ads off; ad slots then render nothing in production.
VITE_ADSENSE_CLIENT=
