PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/blogweb
# A long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Shared secret; set the same value in frontend/.env
INTERNAL_API_KEY=
MEDIA_PUBLIC_URL=http://localhost:4000/media
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_NAME=Site Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_EDITOR_NAME=Staff Editor
SEED_EDITOR_EMAIL=editor@example.com
SEED_EDITOR_PASSWORD=

# Optional: connects the admin panel to Google Search Console. The whole JSON key
# of a service account that is a user of the property, on one line.
GSC_SERVICE_ACCOUNT_JSON=

# Optional, local only: `npm run keywords` (keyword research for new stories).
# GSC_KEY_FILE is a path to the Search Console key file, used when
# GSC_SERVICE_ACCOUNT_JSON is empty. The Bing key comes from Bing Webmaster Tools
# (Settings, API access).
GSC_KEY_FILE=
BING_WEBMASTER_API_KEY=
